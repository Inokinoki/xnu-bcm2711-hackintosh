# Run by /sbin/launchd (userland/src/init/init.c) before it starts the interactive shell. The selftest below
# prints markers on the console that the QEMU boot job in CI looks for.
export OS_LOG_STDERR=1
hostname macpi
echo "rc: start"
echo "rc: shell is $0, bash $BASH_VERSION"
uname -a
id
echo "rc: arithmetic $((6 * 7))"
echo hello | cat | wc -c
ls -l /
ls /usr/lib
echo "rc: file tests"
echo data > /tmp/selftest && cp /tmp/selftest /tmp/selftest2 && cat /tmp/selftest2 && rm /tmp/selftest /tmp/selftest2
echo "rc: vm range"
semtest vm
echo "rc: bootstrap"
semtest bootstrap
echo "rc: user lookup"
id root
ls -ld /var/root /etc/passwd
echo "rc: sort"
first=$(sort /etc/passwd | head -1)
[ "$first" = "# User Database" ] && echo "rc: sort ok" || echo "rc: sort FAILED: $first"
echo b > /tmp/s1 && echo a >> /tmp/s1 && sort /tmp/s1 | tr '\n' ' ' && echo && rm /tmp/s1
echo "rc: grep"
n=$(grep -c '^root:' /etc/master.passwd)
[ "$n" = 1 ] && echo "rc: grep ok" || echo "rc: grep FAILED: $n"
echo "a b c" | grep -o b
echo "rc: grep v: $(printf 'x\ny\n' | grep -v x)"
echo "rc: dev"
echo x > /dev/null && echo "rc: dev null ok"
[ "$(head -c 4 /dev/zero | wc -c | tr -d ' ')" = 4 ] && echo "rc: dev zero ok"
echo "rc: dev tty" > /dev/tty && echo "rc: dev tty ok"
echo "rc: system cmds"
sysctl kern.ostype kern.osrelease hw.pagesize
pagesize
getconf PAGE_SIZE
dmesg | head -2
mount
echo "rc: done USERLAND-SELFTEST-OK"
