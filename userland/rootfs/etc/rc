# Run by /sbin/launchd (userland/src/init/init.c) before it starts the interactive shell. The selftest below
# prints markers on the console that the QEMU boot job in CI looks for.
export OS_LOG_STDERR=1
hostname macpi
echo "rc: start"
echo "rc: shell is $0, bash $BASH_VERSION"
uname -a
id
echo "rc: arithmetic $((6 * 7))"
echo hello | cat | wc -c
ls -l /
ls /usr/lib
echo "rc: file tests"
echo data > /tmp/selftest && cp /tmp/selftest /tmp/selftest2 && cat /tmp/selftest2 && rm /tmp/selftest /tmp/selftest2
echo "rc: user lookup"
id root
id -un
ls -ld /var/root /etc/passwd
echo "rc: sort"
wc -l /etc/passwd
t() { echo "rc: sort [$*]"; "$@" < /etc/passwd > /tmp/sortout; echo "rc: exit $? bytes $(wc -c < /tmp/sortout)"; }
semtest; echo "rc: semtest exit $?"
t sort
t sort -k1
t sort -k1,1 -t:
t sort -n
t sort -u
t sort -m
t sort -c
t sort -b
t sort -f
t sort -d
sort -o /tmp/sortout2 /etc/passwd; echo "rc: sort -o exit $? bytes $(wc -c < /tmp/sortout2)"
echo b | sort; echo "rc: tiny sort exit $?"
echo "rc: done USERLAND-SELFTEST-OK"
