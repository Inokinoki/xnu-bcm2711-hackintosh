+/*
+ * sdpart=N (1-4) exposes the Nth MBR primary partition as sdroot0 instead of the whole card,
+ * so the card can carry a FAT boot partition for the Pi firmware in front of the root.
+ */
+static int
+sd_select_partition(uint32_t part)
+{
+	uint8_t mbr[SECSIZE];
+	int error = sd_xfer(0, 1, mbr, false);
+	if (error) {
+		return error;
+	}
+	if (mbr[510] != 0x55 || mbr[511] != 0xaa) {
+		return ENXIO;
+	}
+	const uint8_t *e = mbr + 446 + 16 * (part - 1);
+	uint32_t start, count;
+	memcpy(&start, e + 8, 4);       /* little-endian LBA, arm64 is little-endian too */
+	memcpy(&count, e + 12, 4);
+	if (e[4] == 0 || count == 0 || start == 0 || (uint64_t)start + count > sd.nblocks) {
+		return ENXIO;
+	}
+	sd.base = start;
+	sd.nblocks = count;
+	return 0;
+}
