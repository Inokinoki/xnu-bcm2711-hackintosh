diff --git a/bsd/kern/kern_trustcache.c b/bsd/kern/kern_trustcache.c
index 4c22764..9d501b5 100644
--- a/bsd/kern/kern_trustcache.c
+++ b/bsd/kern/kern_trustcache.c
@@ -220,6 +220,7 @@ ppl_check_trust_cache_runtime_for_uuid(
 /* Lock for the runtime */
 LCK_GRP_DECLARE(trust_cache_lck_grp, "trust_cache_lck_grp");
 decl_lck_rw_data(, trust_cache_rt_lock);
+static bool trust_cache_rt_lock_ready = false;
 
 /* Immutable part of the runtime */
 SECURITY_READ_ONLY_LATE(TrustCacheRuntime_t) trust_cache_rt_storage;
@@ -270,6 +271,7 @@ trust_cache_runtime_init(void)
 
 	/* Initialize the read-write lock */
 	lck_rw_init(&trust_cache_rt_lock, &trust_cache_lck_grp, 0);
+	trust_cache_rt_lock_ready = true;
 }
 
 static kern_return_t
@@ -696,6 +698,15 @@ query_trust_cache(
 		return KERN_INVALID_ARGUMENT;
 	}
 
+	/*
+	 * BCM2711 port: there is no trust cache and the runtime lock is never initialized on this
+	 * path (taking it panics, "non-sleepable RW lock with preemption enabled"). Nothing is
+	 * trusted, so the shared cache falls back to the root ownership check.
+	 */
+	if (!trust_cache_rt_lock_ready) {
+		return KERN_NOT_FOUND;
+	}
+
 #if   PMAP_CS_PPL_MONITOR
 	ret = ppl_query_trust_cache(query_type, cdhash, query_token);
 #else
