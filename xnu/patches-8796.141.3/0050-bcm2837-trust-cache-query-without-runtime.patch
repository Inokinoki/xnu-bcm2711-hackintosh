diff --git a/bsd/kern/kern_trustcache.c b/bsd/kern/kern_trustcache.c
index 4c22764..34a1921 100644
--- a/bsd/kern/kern_trustcache.c
+++ b/bsd/kern/kern_trustcache.c
@@ -696,6 +696,15 @@ query_trust_cache(
 		return KERN_INVALID_ARGUMENT;
 	}
 
+	/*
+	 * BCM2711 port: there is no trust cache and the runtime lock is never initialized on this
+	 * path (taking it panics, "non-sleepable RW lock with preemption enabled"). Nothing is
+	 * trusted, so the shared cache falls back to the root ownership check.
+	 */
+	if (trust_cache_rt_lock.lck_rw_can_sleep == 0) {
+		return KERN_NOT_FOUND;
+	}
+
 #if   PMAP_CS_PPL_MONITOR
 	ret = ppl_query_trust_cache(query_type, cdhash, query_token);
 #else
